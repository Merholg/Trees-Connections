<?xml version="1.0" encoding="UTF-8" ?>
<project name="Trees-Connections" database="LogicalDesign" id="c1278e0b-1744-4fe7-8121-0a20c8548cab" >
	<comment><![CDATA[database of tree's connections for electrical panels]]></comment>
	<schema name="Schema_Trees-Connections" >
		<table name="Nodes" prior="Node" >
			<column name="NodeID" type="BIGINT" mandatory="y" />
			<column name="NodeName" type="TEXT" mandatory="y" />
			<column name="PointID" type="BIGINT" mandatory="y" />
			<index name="pk_Nodes" unique="PRIMARY_KEY" >
				<column name="NodeID" />
			</index>
			<index name="unq_PointID" unique="UNIQUE_INDEX" >
				<column name="PointID" />
			</index>
			<index name="unq_Nodes_PointID" unique="UNIQUE_KEY" >
				<column name="PointID" />
			</index>
		</table>
		<table name="Points" prior="Point" >
			<column name="PointID" type="BIGINT" mandatory="y" />
			<column name="PointCoordX" type="DECIMAL" mandatory="y" />
			<column name="PointCoordY" type="DECIMAL" mandatory="y" />
			<index name="pk_Point" unique="PRIMARY_KEY" >
				<column name="PointID" />
			</index>
			<fk name="fk_Points_Nodes" to_schema="Schema_Trees-Connections" to_table="Nodes" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" >
				<fk_column name="PointID" pk="PointID" />
			</fk>
		</table>
	</schema>
	<diagram_group name="Default" id="bb55a121-62c1-4b6d-bbb1-8b23dbda5cd5" >
		<diagram name="Trees-Connections-Diagram" id="6479c7f9-a91b-45a9-9c65-03f1d3f408cb" show_relation="columns" >
			<entity schema="Schema_Trees-Connections" name="Nodes" color="C1D8EE" x="57" y="57" />
			<entity schema="Schema_Trees-Connections" name="Points" color="C1D8EE" x="779" y="133" />
		</diagram>
	</diagram_group>
</project>